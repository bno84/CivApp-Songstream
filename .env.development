# Loaded by `pnpm run dev`, `dev:harness` and `dev:tunnel`. The harness fires
# BLOCK_INIT from the dev server's own origin (localhost:5186), and `dev:tunnel`
# embeds this dev server inside the real host on any Civitai domain (the
# CIVITAI_PARENT_ORIGINS in src/dev-embed.js), so both are allowed here.
# Development only: the production allowlist lives in .env.production.
VITE_BLOCK_ALLOWED_PARENT_ORIGINS=http://localhost:5186,https://civitai.com,https://civitai.red,https://civitai.green
