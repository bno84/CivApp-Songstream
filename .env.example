# Comma-separated list of allowed parent-frame origins. The SDK's IframeTransport
# drops every inbound postMessage whose origin is not listed, and refuses to mount
# when the list is empty. Baked in at build time.
#
# Production (.env.production): local `pnpm run build` only. The platform's build
# sets this variable itself, which overrides the .env files.
#   VITE_BLOCK_ALLOWED_PARENT_ORIGINS=https://civitai.com,https://civitai.red,https://civitai.green,https://www.civitai.com
#
# Development (.env.development): also the dev-server origin, for the harness and
# for `pnpm run dev:tunnel` inside the real host.
#   VITE_BLOCK_ALLOWED_PARENT_ORIGINS=http://localhost:5186,https://civitai.com,https://civitai.red,https://civitai.green

# "true" mounts the mock host with sample playlists (`pnpm run dev:harness`).
# Never set it in a production build.
VITE_DEV_HARNESS=
