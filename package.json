{
  "name": "songstream",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:harness": "VITE_DEV_HARNESS=true vite --host localhost --port 5186",
    "dev:tunnel": "CIVITAI_DEV_TUNNEL_HMR=1 vite --host localhost --port 5186 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@civitai/app-sdk": "^0.96.0",
    "@civitai/blocks-react": "^0.88.0",
    "@civitai/sdk": "0.34.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@civitai/cli": "^0.1.154",
    "@eslint-react/eslint-plugin": "5.30.6",
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "description": "Songstream: a Civitai app that feels like a music player. Media control button support, playlists, shuffle.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bno84/CivApp-Songstream.git"
  }
}
